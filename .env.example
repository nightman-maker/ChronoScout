# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# EBAY_CLIENT_ID: Optional official eBay Developer App ID (Client ID).
# Register for free at https://developer.ebay.com to enable 24/7 live listing queries.
EBAY_CLIENT_ID="MY_EBAY_CLIENT_ID"

# EBAY_CLIENT_SECRET: Optional official eBay Developer Cert ID (Client Secret).
EBAY_CLIENT_SECRET="MY_EBAY_CLIENT_SECRET"

# EBAY_MARKETPLACE: Target marketplace. EBAY_DE (Germany), EBAY_CH (Switzerland), EBAY_FR (France), EBAY_IT (Italy), EBAY_GB (UK)
EBAY_MARKETPLACE="EBAY_DE"
